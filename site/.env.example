# Checkout is built but switched off until launch. Set to "true" to open it.
NEXT_PUBLIC_CHECKOUT_LIVE=false

# Shopify Storefront API (headless cart -> Shopify checkout)
SHOPIFY_STORE_DOMAIN=paleorobbie-ritual.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-10

# Map our pack ids to Shopify ProductVariant GIDs once the products exist in Shopify
SHOPIFY_VARIANT_WEEKLY=gid://shopify/ProductVariant/0
SHOPIFY_VARIANT_SAMPLER=gid://shopify/ProductVariant/0
SHOPIFY_VARIANT_PEACH_OF_MIND=gid://shopify/ProductVariant/0
SHOPIFY_VARIANT_TO_THE_BEET=gid://shopify/ProductVariant/0
SHOPIFY_VARIANT_ZEST_LIFE=gid://shopify/ProductVariant/0
SHOPIFY_VARIANT_CALM_O_MILE=gid://shopify/ProductVariant/0
